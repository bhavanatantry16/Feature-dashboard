# === GitHub ===
# Fine-grained or classic Personal Access Token
# Scopes for classic PAT: repo (read), read:org, read:user, read:project
# For fine-grained: Repo read (Actions, Checks, Commit statuses, Contents, Deployments, Issues, Metadata, Pull requests), Org read (Members)
GITHUB_TOKEN=

# Comma-separated list. Either "owner/repo" pairs, or a full "org" name to pull all its repos.
# Examples:
#   GITHUB_SCOPE=vercel/next.js,facebook/react
#   GITHUB_SCOPE=my-org
GITHUB_SCOPE=

# Optional: GitHub Enterprise Server base API URL (default: https://api.github.com)
GITHUB_API_BASE=https://api.github.com

# Optional: webhook secret for real-time updates (POST /api/webhooks/github)
GITHUB_WEBHOOK_SECRET=

# --- Environment mapping (which branch or deployment env corresponds to each canonical env) ---
ENV_DEV_KEYS=dev,develop,development,staging-dev
ENV_TEST_KEYS=test,qa,testing,sit
ENV_UAT_KEYS=uat,staging,stage,preprod,pre-prod
ENV_PROD_KEYS=main,master,prod,production,release,live

# --- Azure DevOps (optional deployment source — powers the Board's Dev/Test/Prod presence) ---
# Paste any project URL from your Azure DevOps org for the environment slot.
# You can point all three slots at the same project — the stage-name keywords
# above (ENV_DEV_KEYS / ENV_TEST_KEYS / ENV_PROD_KEYS) decide which release stage
# fills which slot.
AZDO_URL_DEV=
AZDO_URL_TEST=
AZDO_URL_PROD=
# A single PAT is used for all three URLs. Scopes: Build (Read), Release (Read).
AZDO_PAT=

# --- Server ---
PORT=8788
CACHE_TTL_SECONDS=60
CLIENT_REFRESH_SECONDS=60
CORS_ORIGINS=

# --- RBAC (optional) ---
# Comma-separated role assignments. Format: gh-login:role
# Roles: admin, manager, developer, qa, devops, product, viewer
RBAC_ASSIGNMENTS=
